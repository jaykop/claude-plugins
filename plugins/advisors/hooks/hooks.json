{
  "description": "advisors — 세션 시작 때 때가 된 고문 점검과 열린 질문을 한 줄로 알린다 (프로필이 있는 프로젝트에서만)",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/due-check.sh\" \"${CLAUDE_PLUGIN_ROOT}/scripts/due_check.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
