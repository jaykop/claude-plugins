{
  "description": "workflow — 문서 검토 트레일러 없는 커밋 차단과 긴 세션의 인계 메모 권유. 프로필에서 켠 프로젝트에서만 동작한다.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/run-py.sh\" \"${CLAUDE_PLUGIN_ROOT}/hooks/commit_gate.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/run-py.sh\" \"${CLAUDE_PLUGIN_ROOT}/hooks/handoff_reminder.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
